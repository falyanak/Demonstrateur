<?xml version="1.0" encoding="utf-8"?>
<!-- Sources NuGet du projet (DEB-Q11) : nuget.org seul, sans hériter des sources du poste (flux d'entreprise désactivé,
     paquets hors ligne de Visual Studio). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
