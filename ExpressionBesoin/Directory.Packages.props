<Project>
  <!-- Une version par paquet (gestion centralisée). Principe des versions (DEB-D7) : dernière version stable, épinglée
       exactement ; versions relevées sur nuget.org le 21/11/2026 (lot HY1, DEB-HY1). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- xUnit 4 (DEB-Q46, révise « xUnit v3 ») : tous les projets de tests migrés ensemble ; Microsoft Testing Platform
         v2 par défaut. 4.0.3 du 09/11/2026. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <!-- Série 4 de l'adaptateur Visual Studio, celle qui accompagne xUnit 4 ; 4.0.1 du 09/10/2026. -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- Série 10.0 du framework partagé ASP.NET Core 10 (DEB-Q45 : .NET 10 LTS ; la 11.0.0 ne cible que net11.0). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <!-- Infrastructure (lot I1, DEB-Q12) : SQLite sans Entity Framework ; série 10.0 du framework (DEB-Q45), 10.0.15 du
         10/11/2026 ; dépend toujours de SQLitePCLRaw 2.1.x (2.1.13), dont ConnexionsSqlite appelle sqlite3_db_config. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <!-- Adaptateur IA réel (lot A1, DEB-D5, DEB-Q83 à DEB-Q88) : Microsoft Agent Framework (ChatClientAgent) sur l'IChatClient
         OpenAI de Microsoft.Extensions.AI. Microsoft.Agents.AI 1.28.0 du 06/11/2026, dernière stable ; elle dépend de
         Microsoft.Extensions.AI 10.11. -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <!-- Version RETENUE EN RETRAIT : 10.11.1 du 20/11/2026, et non 11.0.1 (21/11/2026) : la série 11 change de version
         majeure les abstractions sur lesquelles Microsoft.Agents.AI 1.28.0 est compilé ; on reste sur sa série 10.11.
         Apporte OpenAI 2.x (client compatible, transport HttpClient) et System.ClientModel. -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.1" />
  </ItemGroup>
</Project>
